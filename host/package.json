    "typescript": "~5.8.3",
    "@eslint/js": "^9.25.0",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "typescript-eslint": "^8.30.1",
    "@vitejs/plugin-react": "^3.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
