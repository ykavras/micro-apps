  },
  "devDependencies": {
    "vite": "^6.3.5",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "@eslint/js": "^9.25.0",
    "typescript-eslint": "^8.30.1",
    "@originjs/vite-plugin-federation": "^1.2.1"
  }
}
